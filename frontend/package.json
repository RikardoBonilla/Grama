{
  "name": "grama-frontend",
  "version": "0.1.0",
  "description": "Grama — Plataforma de reservas de canchas sintéticas (Ionic + Angular)",
  "private": true,
  "scripts": {
    "start": "ionic serve",
    "build": "ionic build",
    "build:prod": "ionic build --configuration production",
    "build:android": "ionic capacitor build android",
    "build:ios": "ionic capacitor build ios",
    "lint": "ng lint",
    "test": "ng test --coverage",
    "e2e": "ng e2e",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@angular/animations": "~18.2.0",
    "@angular/common": "~18.2.0",
    "@angular/compiler": "~18.2.0",
    "@angular/core": "~18.2.0",
    "@angular/forms": "~18.2.0",
    "@angular/platform-browser": "~18.2.0",
    "@angular/platform-browser-dynamic": "~18.2.0",
    "@angular/router": "~18.2.0",
    "@capacitor/android": "~6.0.0",
    "@capacitor/core": "~6.0.0",
    "@capacitor/ios": "~6.0.0",
    "@capacitor/preferences": "^8.0.1",
    "@ionic/angular": "~8.0.0",
    "ionicons": "~7.4.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.6.0",
    "zone.js": "~0.14.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "~18.2.0",
    "@angular/cli": "~18.2.0",
    "@angular/compiler-cli": "~18.2.0",
    "@capacitor/cli": "~6.0.0",
    "@ionic/cli": "^7.0.0",
    "@types/jasmine": "~5.1.0",
    "jasmine-core": "~5.2.0",
    "karma": "~6.4.0",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "~2.1.0",
    "typescript": "~5.4.0"
  }
