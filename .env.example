# === Base de datos (superuser para inicializar — solo Docker Compose) ===
POSTGRES_USER=grama_admin
POSTGRES_PASSWORD=CHANGE_ME_IN_LOCAL_ENV
POSTGRES_DB=grama_db

# === Conexión desde el backend (usuario con permisos mínimos — creado en GRAM-6) ===
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
GRAMA_DB_USER=grama_user
GRAMA_DB_PASSWORD=CHANGE_ME_IN_LOCAL_ENV
# sslmode=disable is for local dev ONLY. Change to require or verify-full in staging/prod.
GRAMA_DB_DSN=postgres://grama_user:CHANGE_ME_IN_LOCAL_ENV@127.0.0.1:5433/grama_db?sslmode=disable

# === JWT ===
JWT_SECRET=CHANGE_ME_MIN_32_CHARS_RANDOM_STRING
JWT_ACCESS_TTL_MINUTES=15
JWT_REFRESH_TTL_DAYS=7

# === Servidor ===
SERVER_PORT=8080
SERVER_ENV=development

# === SonarQube (solo local) ===
SONAR_HOST_URL=http://localhost:9000
SONAR_TOKEN=CHANGE_ME
